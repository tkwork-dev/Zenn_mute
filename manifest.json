{
  "manifest_version": 3,
  "name": "Zenn Mute User Alert",
  "version": "1.1.0",
  "description": "Zennでミュートしたユーザーの記事を開いた際に警告モーダルを表示します",
  "permissions": ["storage"],
  "host_permissions": ["https://zenn.dev/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://zenn.dev/*"],
      "js": ["content.js"],
      "css": ["modal.css"],
      "run_at": "document_idle"
    }
  ]
}
